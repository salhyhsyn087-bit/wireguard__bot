PEERS = fetch_github_peers()

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    c.execute("INSERT OR IGNORE INTO users (user_id, step) VALUES (?, ?)", (user_id, ""))
    conn.commit()
    await update.message.reply_text("⚡ سلام! نام کانفیگ رو وارد کن:")

async def game_menu(update: Update, context: ContextTypes.DEFAULT_TYPE, message=None):
    keyboard = [
        [InlineKeyboardButton("🎮 پابجی موبایل", callback_data="game_pubg")],
        [InlineKeyboardButton("🔥 فری فایر", callback_data="game_freefire")],
        [InlineKeyboardButton("🔫 کالاف دیوتی", callback_data="game_callofduty")],
        [InlineKeyboardButton("🌐 معمولی", callback_data="game_normal")]
    ]
    if message:
        await message.reply_text("🎮 بازی مورد نظرتو انتخاب کن:", reply_markup=InlineKeyboardMarkup(keyboard))
    else:
        await update.message.reply_text("🎮 بازی مورد نظرتو انتخاب کن:", reply_markup=InlineKeyboardMarkup(keyboard))

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    user_id = query.from_user.id

    if data.startswith("game_"):
        game = data.replace("game_", "")
        c.execute("UPDATE users SET temp_game = ? WHERE user_id = ?", (game, user_id))
        conn.commit()
        
        c.execute("SELECT temp_name, temp_volume, temp_expiry FROM users WHERE user_id = ?", (user_id,))
        row = c.fetchone()
        if row and row[0] and row[1] and row[2]:
            await finish_config(user_id, query)
        else:
            await query.edit_message_text("✅ انتخاب شد! حالا نام کانفیگ رو وارد کن:")
            c.execute("UPDATE users SET step = 'waiting_name' WHERE user_id = ?", (user_id,))
            conn.commit()

async def finish_config(user_id, query):
    c.execute("SELECT temp_name, temp_volume, temp_expiry, temp_game FROM users WHERE user_id = ?", (user_id,))
    name, volume, expiry, game = c.fetchone()
    
    server = GAME_SERVERS[game]
    
    config_data = generate_config(name, volume, expiry, game, server)
    
    filename = f"{user_id}_{name}_{game}.conf"
    filepath = f"configs/{filename}"
    with open(filepath, "w") as f:
        f.write(config_data)
    
    c.execute("INSERT INTO configs (user_id, name, volume, expiry, game, file_path, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
              (user_id, name, volume, expiry, game, filepath, datetime.now().isoformat()))
    c.execute("UPDATE users SET step = '', temp_name = NULL, temp_volume = NULL, temp_expiry = NULL, temp_game = NULL WHERE user_id = ?", (user_id,))
    conn.commit()
    
    game_name = GAME_SERVERS[game]["name"]
    with open(filepath, "rb") as f:
        await query.message.reply_document(
            document=f, 
            filename=filename, 
            caption=f"✅ کانفیگ وایرگارد برای {game_name} آماده‌ست!\n📛 نام: {name}\n💾 حجم: {volume}\n📅 انقضا: {expiry}"
        )

def generate_config(name, volume, expiry, game, server):
    idx = (hash(name + game + str(random.randint(1, 9999))) % len(PEERS))
    private_key = PEERS[idx]
    
    return f"""[Interface]
Address = {server['address']}
DNS = {server['dns']}
PrivateKey = {private_key}
ListenPort = {random.randint(40000, 60000)}
MTU = 1305

[Peer]
PublicKey = {server['public_key']}
Endpoint = {server['endpoint']}
PersistentKeepalive = 25
AllowedIPs = 0.0.0.0/0"""

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = update.message.text.strip()

    c.execute("SELECT step, temp_name, temp_volume, temp_expiry, temp_game FROM users WHERE user_id = ?", (user_id,))
    row = c.fetchone()

    if not row:
        c.execute("INSERT INTO users (user_id, step) VALUES (?, ?)", (user_id, ""))
        conn.commit()
        await update.message.reply_text("/start رو بزن")
        return

    step, temp_name, temp_volume, temp_expiry, temp_game = row

    if step == "" or step == "waiting_name":
        c.execute("UPDATE users SET step = 'waiting_volume', temp_name = ? WHERE user_id = ?", (text, user_id))
        conn.commit()
        await update.message.reply_text("📦 حجم کانفیگ رو وارد کن (مثلاً 50GB یا 100GB):")

    elif step == "waiting_volume":
        c.execute("UPDATE users SET step = 'waiting_expiry', temp_volume = ? WHERE user_id = ?", (text, user_id))
        conn.commit()
        await update.message.reply_text("📅 تاریخ انقضا رو وارد کن (مثلاً 2025-12-31):")

    elif step == "waiting_expiry":
        c.execute("UPDATE users SET temp_expiry = ? WHERE user_id = ?", (text, user_id))
        conn.commit()
        await game_menu(update, context, message=update.message)

def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    print(f"ربات روشن شد! تعداد کلیدهای موجود: {len(PEERS)}")
    app.run_polling()

if __name__ == "__main__":
    main()
